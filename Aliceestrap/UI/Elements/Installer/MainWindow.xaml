<base:WpfUiWindow x:Class="Aliceestrap.UI.Elements.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:Aliceestrap.UI.Elements.Installer.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Aliceestrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:Aliceestrap.Resources"
        xmlns:dmodels="clr-namespace:Aliceestrap.UI.ViewModels.Installer"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
        Title="{x:Static resources:Strings.Installer_Title}"
        Height="560" Width="840" MinWidth="840"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="current">
                    <Setter Property="Background" Value="{DynamicResource ShellNavSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ShellGlowStartBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="done">
                    <Setter Property="BorderBrush" Value="{DynamicResource ShellGlowStartBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ShellHeaderBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <ui:TitleBar x:Name="RootTitleBar" Padding="0" Height="64" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" ShowMaximize="False" Title="" />

                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <Border Width="30" Height="30" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Aliceestrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="aliceestrap" Foreground="{DynamicResource ShellGlowBrush}" />
                        <TextBlock FontSize="11" Text="{x:Static resources:Strings.Installer_Title}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,110,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False">
                    <Border x:Name="Step0" Style="{StaticResource StepDot}" Tag="current">
                        <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="StepLabel0" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{x:Static resources:Strings.Installer_Welcome_Title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Rectangle Width="28" Height="1.5" Margin="12,0" VerticalAlignment="Center" Fill="{DynamicResource ControlStrokeColorSecondaryBrush}" />

                    <Border x:Name="Step1" Style="{StaticResource StepDot}" Tag="todo">
                        <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="StepLabel1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{x:Static resources:Strings.Installer_Install_Title}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Rectangle Width="28" Height="1.5" Margin="12,0" VerticalAlignment="Center" Fill="{DynamicResource ControlStrokeColorSecondaryBrush}" />

                    <Border x:Name="Step2" Style="{StaticResource StepDot}" Tag="todo">
                        <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="StepLabel2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{x:Static resources:Strings.Installer_Completion_Title}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationFluent x:Name="RootNavigation" Grid.Row="1" Visibility="Collapsed" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0" IsEnabled="False">
            <ui:NavigationFluent.Items>
                <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Welcome_Title}" PageType="{x:Type pages:WelcomePage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Install_Title}" PageType="{x:Type pages:InstallPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Completion_Title}" PageType="{x:Type pages:CompletionPage}" />
            </ui:NavigationFluent.Items>
        </ui:NavigationFluent>

        <Frame x:Name="RootFrame" Grid.Row="1" MaxWidth="760" Margin="32,22,18,0" />

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource ShellFooterBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,8,0" Appearance="Transparent" Content="{x:Static resources:Strings.Common_Close}" Width="{Binding ButtonWidth, Mode=OneTime}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
                <ui:Button Margin="0,0,8,0" Content="{x:Static resources:Strings.Common_Navigation_Back}" Width="{Binding ButtonWidth, Mode=OneTime}" Command="{Binding BackPageCommand, Mode=OneWay}" IsEnabled="{Binding BackButtonEnabled, Mode=OneWay}" />
                <ui:Button Name="NextButton" Appearance="Primary" Content="{Binding NextButtonText, Mode=OneWay}" Width="{Binding ButtonWidth, Mode=OneTime}" Command="{Binding NextPageCommand, Mode=OneWay}" IsEnabled="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
