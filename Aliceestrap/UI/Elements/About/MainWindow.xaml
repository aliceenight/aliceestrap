<base:WpfUiWindow x:Class="Aliceestrap.UI.Elements.About.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:Aliceestrap.UI.Elements.Base"
             xmlns:models="clr-namespace:Aliceestrap.UI.ViewModels"
             xmlns:dmodels="clr-namespace:Aliceestrap.UI.ViewModels.About"
             xmlns:resources="clr-namespace:Aliceestrap.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:AboutViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.About_Title}"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Width="560"
             Height="640"
             MinWidth="480"
             MinHeight="400"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="None"
             WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="0" Height="44" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" Title="" />

        <ui:DynamicScrollViewer Grid.Row="1">
            <StackPanel Margin="28,0,28,28">
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,24">
                    <Border Width="84" Height="84" CornerRadius="22" Padding="3" HorizontalAlignment="Center" Background="{DynamicResource ShellGlowBrush}">
                        <Border CornerRadius="19" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Aliceestrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="aliceestrap" Foreground="{DynamicResource ShellGlowBrush}" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="13" Text="{Binding Version, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" Text="{x:Static resources:Strings.Menu_About_Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Visibility="{Binding BuildInformationVisibility, Mode=OneTime}" Margin="0,0,0,24" Padding="16,12" CornerRadius="12" Background="{DynamicResource ShellNavHoverBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,2,16,2" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Built" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" FontSize="13" Text="{Binding BuildTimestamp, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,16,2" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Commit" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" FontSize="13" Text="{Binding BuildMetadata.CommitHash, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,2,16,2" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Ref" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2,0,2" FontSize="13" Text="{Binding BuildMetadata.CommitRef, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                    </Grid>
                </Border>

                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Strings.About_Licenses_Title}" />
                <Rectangle Width="28" Height="3" Margin="1,8,0,10" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ShellGlowBrush}" />

                <ItemsControl ItemsSource="{Binding Licenses, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:LicenseEntry}">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding Url}" Cursor="Hand" ToolTip="{Binding Url}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Padding="12,10" CornerRadius="10" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="13" FontWeight="Medium" Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Margin="12,0,10,0" FontSize="12" Text="{Binding License}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <ui:SymbolIcon Grid.Column="2" Symbol="Open16" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</base:WpfUiWindow>
