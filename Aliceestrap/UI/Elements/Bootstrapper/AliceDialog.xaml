<base:WpfUiWindow
    x:Class="Aliceestrap.UI.Elements.Bootstrapper.AliceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Aliceestrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Aliceestrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:Aliceestrap.UI.ViewModels.Bootstrapper"
    Width="468"
    MinHeight="0"
    SizeToContent="Height"
    d:DataContext="{d:DesignInstance vms:AliceDialogViewModel,
                                     IsDesignTimeCreatable=True}"
    AllowsTransparency="True"
    Background="Transparent"
    Closing="UiWindow_Closing"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowBackdropType="None"
    WindowCornerPreference="DoNotRound"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Style x:Key="AliceProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource ShellNavSelectedBrush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ShellGlowBrush}" />
                            <Border x:Name="Runner" Width="120" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ShellGlowBrush}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-120" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="RunnerStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="Runner"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="-120"
                                                To="420"
                                                Duration="0:0:1.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RunnerStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" Background="{DynamicResource ShellGlowBrush}" Opacity="0.14" IsHitTestVisible="False">
            <Border.OpacityMask>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.9" RadiusY="1.4">
                    <GradientStop Offset="0" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </RadialGradientBrush>
            </Border.OpacityMask>
        </Border>

        <Border x:Name="Card" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Background="Transparent" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid Margin="22,20,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2" Padding="10,3,10,4" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource ShellNavSelectedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BranchFork20" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellNavSelectedTextBrush}" />
                            <TextBlock FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ShellNavSelectedTextBrush}" Text="{Binding Channel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProgressText, Mode=OneWay}" Visibility="{Binding ProgressTextVisibility, Mode=OneWay}" />
                </Grid>

                <ProgressBar
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                    Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                    Style="{StaticResource AliceProgressBar}"
                    Value="{Binding ProgressValue, Mode=OneWay}" />

                <Grid Grid.Row="3" Margin="0,16,0,0" MinHeight="30">
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Footer, Mode=OneTime}" />
                    <ui:Button
                        HorizontalAlignment="Right"
                        Padding="16,5,16,6"
                        Appearance="Secondary"
                        Command="{Binding CancelInstallCommand}"
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        FontSize="13"
                        IsEnabled="{Binding CancelEnabled, Mode=OneWay}"
                        Visibility="{Binding CancelButtonVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
