    <Color x:Key="TextFillColorTertiary">#FF7A6E88</Color>
    <Color x:Key="TextFillColorDisabled">#FFA89EB3</Color>
    <Color x:Key="TextPlaceholderColor">#FF8A7F97</Color>
    <Color x:Key="ControlFillColorDefault">#CCFFFFFF</Color>
    <Color x:Key="ControlFillColorSecondary">#99FBF8FE</Color>
    <Color x:Key="ControlFillColorTertiary">#66F5F0FA</Color>
    <Color x:Key="ControlFillColorDisabled">#4DF9F9F9</Color>
    <Color x:Key="ControlFillColorInputActive">#FFFFFFFF</Color>
    <Color x:Key="ControlStrokeColorDefault">#1F4A2E7A</Color>
    <Color x:Key="ControlStrokeColorSecondary">#2E4A2E7A</Color>
    <Color x:Key="CardStrokeColorDefault">#1F4A2E7A</Color>
    <Color x:Key="CardStrokeColorDefaultSolid">#FFE6DDF0</Color>
    <Color x:Key="DividerStrokeColorDefault">#1F4A2E7A</Color>
    <Color x:Key="CardBackgroundFillColorDefault">#D9FFFFFF</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#80FFFFFF</Color>
